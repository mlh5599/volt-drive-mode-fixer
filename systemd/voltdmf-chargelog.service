[Unit]
Description=Volt Drive Mode Fixer -- charge-current-setpoint capture (panel-launched)
Documentation=file:///usr/share/doc/voltdmf/DESIGN.md
# Started on demand by voltdmf-btn.service when the SW2-solo-hold gesture
# fires; never enabled, never started at boot (no [Install]).
#
# ALWAYS PASSIVE: this is the garage session that hunts the 8 A<->12 A Level 1
# charge-current menu setting (docs/phase-c-field-checklist.md section 2e --
# "force 12 A Level 1 charging"). tools/soc_log.py spawns `candump -l` plus
# its own event log and does not transmit; the always-on broadcast-candidate
# probe is passive too. `--diag-soc` is deliberately NOT offered here -- the
# charge-mode hunt is capture-only, injection is a later Phase C.5 session.
# This is the same tool as voltdmf-soclog.service, just a shorter run and no
# TX path; keep this unit and the ansible `voltdmf` role's copy in sync.
#
# It is independent of voltdmf.service -- not bound to it -- and the daemon's
# LCD watch screen yields via VOLTDMF_LCD_LOCK while this runs, resuming when
# soc_log.py releases the lock on exit.
After=voltdmf.socket

[Service]
Type=oneshot
RemainAfterExit=no

# ~20 min garage session + margin. A oneshot's TimeoutStartSec caps the whole
# run; without it systemd would SIGINT at the 90 s default. soc_log.py stops
# itself at --minutes, or earlier on the hold-BOTH gesture -- this is only a
# backstop ceiling.
TimeoutStartSec=45min

# `systemctl stop` (or the timeout) must reach soc_log.py's clean shutdown:
# it traps KeyboardInterrupt / SIGINT to close the candump capture, write the
# summary, and release the LCD lock. A bare SIGTERM would skip all of that.
KillSignal=SIGINT
TimeoutStopSec=15

# Runs as the operator, exactly like a by-hand `./soc_log.py` run: capture
# and logs land in /home/mike, gpiozero can claim the panel buttons (mike is
# in `gpio`), and the LCD lock in /run/lock (1777) is shared with the daemon.
# The ansible role should template the user; hard-coded here to the known
# operator account on voltpi.
User=mike
Group=mike
SupplementaryGroups=gpio dialout
#   gpio    -> panel buttons SW1/SW2 (BCM 24/23) for --buttons
#   dialout -> /dev/serial0 for --lcd
# (CAN raw sockets for `candump` need no capability -- unprivileged-openable.)

WorkingDirectory=/home/mike
Environment=VOLTDMF_LCD_LOCK=/run/lock/voltdmf-lcd.lock

# soc_log.py already aborts if can0 is STOPPED or absent, and refuses to run
# without --yes. 20 min / 10-bar gauge / SOC-MARK backstop every 2 min. Tap A
# at each 8<->12 A menu toggle; the marks land in the event log next to the
# candidate raws for the offline mine_capture.py --shift-window pass.
ExecStart=/usr/bin/python3 /opt/voltdmf/repo/tools/soc_log.py \
    --yes --minutes 20 --buttons --lcd \
    --button-a-gpio 24 --button-b-gpio 23 \
    --capture-dir /home/mike
